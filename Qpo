-- ==========================================
-- 7. Main Loop (RenderStepped)
-- ==========================================
local lastUpdate = 0
local frameCount = 0

RunService.RenderStepped:Connect(function(dt)
    -- อัปเดตตำแหน่งวงกลม FOV ตามตำแหน่งเมาส์
    local mousePos = UserInputService:GetMouseLocation()
    fovFrame.Position = UDim2.new(0, mousePos.X, 0, mousePos.Y)

    -- ระบบ Lock-On
    if isTargeting then
        if not isTargetValid(currentTarget) then
            currentTarget = getClosestInFOV()
        end

        if currentTarget and currentTarget.Character and currentTarget.Character:FindFirstChild("Head") then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, currentTarget.Character.Head.Position)
        end
    end

    -- คำนวณ FPS และ Ping ปลอดภัยจาก Error
    frameCount = frameCount + 1
    lastUpdate = lastUpdate + dt
    if lastUpdate >= 0.5 then
        local currentFps = math.floor(frameCount / lastUpdate)
        frameCount = 0
        lastUpdate = 0

        if showFps then
            local ping = 0
            pcall(function()
                ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
            end)
            topLeftFpsLabel.Text = " FPS: " .. currentFps .. " | Ping: " .. ping .. "ms"
        end
    end
end)
